PORT=3000
NODE_ENV=development

# Postgres connection used by Prisma
DATABASE_URL=postgresql://urlshortener:urlshortener@localhost:5432/urlshortener

# Redis connection used for redirect caching and rate limiting
REDIS_URL=redis://localhost:6379

# Base used to build the full short URL returned to clients (e.g. http://localhost:3000)
PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Requests per IP allowed to POST /api/urls per RATE_LIMIT_WINDOW_SECONDS
RATE_LIMIT_POINTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Signs the short-lived cookie that remembers a successful password-protected-link
# unlock. CHANGE THIS to a real random secret in production.
LINK_UNLOCK_SECRET=dev-only-unlock-secret-change-me
LINK_UNLOCK_TTL_SECONDS=3600

# Password attempts per IP allowed on a protected link per UNLOCK_RATE_LIMIT_WINDOW_SECONDS
UNLOCK_RATE_LIMIT_POINTS=10
UNLOCK_RATE_LIMIT_WINDOW_SECONDS=300
